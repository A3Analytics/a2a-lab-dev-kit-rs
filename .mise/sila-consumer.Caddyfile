{
	auto_https off
	admin off
	servers {
		protocols h1 h2 h2c
	}
}

http://127.0.0.1:50053 {
	reverse_proxy https://127.0.0.1:50052 {
		flush_interval -1
		transport http {
			versions 2
			tls
			tls_server_name SiLA2
			tls_trust_pool file {$SILA_CA}
		}
	}
}

https://127.0.0.1:50056 {
	tls {$SILA_CERT} {$SILA_KEY}
	reverse_proxy h2c://127.0.0.1:50055 {
		flush_interval -1
		transport http {
			versions h2c
		}
	}
}

{
  "realm": "a2a-test",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "a2a.invoke",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "a2a.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "a2a-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "a2a-lab",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "a2a-lab",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "a2a-valid",
      "name": "Valid caller",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "a2a-valid-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["a2a.invoke", "a2a-audience"]
    },
    {
      "clientId": "a2a-bob",
      "name": "Second caller",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "a2a-bob-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["a2a.invoke", "a2a-audience"]
    },
    {
      "clientId": "a2a-limited",
      "name": "Insufficient scope",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "a2a-limited-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["a2a.read", "a2a-audience"]
    },
    {
      "clientId": "a2a-audience",
      "name": "Wrong audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "a2a-audience-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["a2a.invoke"]
    },
    {
      "clientId": "a2a-expired",
      "name": "Short-lived token",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "a2a-expired-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["a2a.invoke", "a2a-audience"],
      "attributes": {
        "access.token.lifespan": "1"
      }
    }
  ]
}

{
  "schema_version": 2,
  "chat": {
    "provider": "anthropic",
    "model": "claude-chat-only"
  },
  "videos": {
    "sources": [
      {
        "id": "camera",
        "format": "mjpeg",
        "device_index": 12,
        "semantic_indexing": {
          "description": "5s",
          "description_model": "global.openai.gpt-5.6-luna",
          "embeddings": "1m",
          "embedding_model": "cohere.embed-english-v3"
        }
      },
      {
        "id": "external-camera",
        "format": "mjpeg",
        "device_index": 4,
        "semantic_indexing": {
          "description": "1.5s",
          "description_model": "global.openai.gpt-4.1-mini",
          "embeddings": "5s",
          "embedding_model": "cohere.embed-english-v3"
        }
      }
    ]
  },
  "semantic_indexing": {
    "description": {
      "provider": "bedrock",
      "model": "global.openai.gpt-5.6-luna",
      "credentials": {
        "env": "A2ALAB_SEMANTIC_DESCRIPTION_AWS_PROFILE"
      }
    },
    "embeddings": {
      "provider": "bedrock",
      "model": "cohere.embed-english-v3",
      "space": {
        "dimensions": 1024,
        "normalization": "l2_unit",
        "metric": "cosine"
      },
      "credentials": {
        "env": "A2ALAB_SEMANTIC_EMBEDDING_API_KEY"
      }
    },
    "decisions": {
      "provider": "jev",
      "model": "jev-1.14.0",
      "credentials": {
        "env": "A2ALAB_JEV_API_KEY"
      }
    },
    "limits": {
      "worker": {
        "max_batch_items": 8,
        "max_concurrency": 4,
        "max_queue_backlog": 5000,
        "max_retry_attempts": 5,
        "job_deadline": "30s",
        "retry_backoff": "5s"
      },
      "search": {
        "top_k": 10,
        "candidate_limit": 1000,
        "max_neighbor_frames": 5,
        "query_window": "2h"
      },
      "storage": {
        "sqlite_path": "./state/semantic.sqlite",
        "vector_index_path": "./state/semantic-index",
        "max_disk_bytes": 1073741824
      },
      "decisions": {
        "max_batch_items": 8,
        "max_concurrency": 2,
        "job_deadline": "45s",
        "coverage_policy": "all_saved_frames"
      }
    }
  }
}

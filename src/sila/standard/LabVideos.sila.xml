<?xml version="1.0" encoding="utf-8" ?>
<Feature SiLA2Version="1.1" FeatureVersion="1.1" MaturityLevel="Draft" Originator="com.a3analytics" Category="lab"
         xmlns="http://www.sila-standard.org"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>LabVideos</Identifier>
  <DisplayName>Lab Videos</DisplayName>
  <Description>Lists video sources, returns retained timeline coverage, returns a still JPEG at a UTC instant, and serves a finite bounded MJPEG clip. Pixel and clip bytes always use SiLA binary download. No command delivers frames added after the call.</Description>

  <Command>
    <Identifier>ListVideoSources</Identifier>
    <DisplayName>List Video Sources</DisplayName>
    <Description>Returns one page of video sources.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Page</Identifier>
      <DisplayName>Page</DisplayName>
      <Description>Page bounds.</Description>
      <DataType><DataTypeIdentifier>PageRequest</DataTypeIdentifier></DataType>
    </Parameter>
    <Response>
      <Identifier>Sources</Identifier>
      <DisplayName>Sources</DisplayName>
      <Description>Video sources on this page.</Description>
      <DataType><List><DataType><DataTypeIdentifier>VideoSource</DataTypeIdentifier></DataType></List></DataType>
    </Response>
    <Response>
      <Identifier>HasNextCursor</Identifier>
      <DisplayName>Has Next Cursor</DisplayName>
      <Description>True when another page exists.</Description>
      <DataType><Basic>Boolean</Basic></DataType>
    </Response>
    <Response>
      <Identifier>NextCursor</Identifier>
      <DisplayName>Next Cursor</DisplayName>
      <Description>Cursor for the next page. Empty when HasNextCursor is false.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <DefinedExecutionErrors><Identifier>ProviderUnavailable</Identifier></DefinedExecutionErrors>
  </Command>

  <Command>
    <Identifier>GetVideoFrameAt</Identifier>
    <DisplayName>Get Video Frame At</DisplayName>
    <Description>Returns the nearest retained JPEG at a UTC instant, including its pixel bytes.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Video source identifier.</Description>
      <DataType>
        <Constrained>
          <DataType><Basic>String</Basic></DataType>
          <Constraints>
            <MinimalLength>1</MinimalLength>
            <MaximalLength>128</MaximalLength>
            <Pattern>[A-Za-z0-9._:\-]+</Pattern>
          </Constraints>
        </Constrained>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>At</Identifier>
      <DisplayName>At</DisplayName>
      <Description>UTC instant to look up.</Description>
      <DataType><Basic>Timestamp</Basic></DataType>
    </Parameter>
    <Parameter>
      <Identifier>HasMaxDeltaUs</Identifier>
      <DisplayName>Has Max Delta Us</DisplayName>
      <Description>True when MaxDeltaUs is set.</Description>
      <DataType><Basic>Boolean</Basic></DataType>
    </Parameter>
    <Parameter>
      <Identifier>MaxDeltaUs</Identifier>
      <DisplayName>Max Delta Us</DisplayName>
      <Description>Maximum absolute delta from At, in microseconds. Ignored when HasMaxDeltaUs is false.</Description>
      <DataType><Basic>Integer</Basic></DataType>
    </Parameter>
    <Response>
      <Identifier>RequestedAt</Identifier>
      <DisplayName>Requested At</DisplayName>
      <Description>UTC instant the caller asked for.</Description>
      <DataType><Basic>Timestamp</Basic></DataType>
    </Response>
    <Response>
      <Identifier>ActualCapturedAt</Identifier>
      <DisplayName>Actual Captured At</DisplayName>
      <Description>UTC capture time of the selected frame.</Description>
      <DataType><Basic>Timestamp</Basic></DataType>
    </Response>
    <Response>
      <Identifier>DeltaUs</Identifier>
      <DisplayName>Delta Us</DisplayName>
      <Description>Signed delta actual minus requested, in microseconds.</Description>
      <DataType><Basic>Integer</Basic></DataType>
    </Response>
    <Response>
      <Identifier>ImageId</Identifier>
      <DisplayName>Image Id</DisplayName>
      <Description>Still identifier.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Source that supplied the still.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>MediaType</Identifier>
      <DisplayName>Media Type</DisplayName>
      <Description>Image media type.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>Width</Identifier>
      <DisplayName>Width</DisplayName>
      <Description>Width in pixels.</Description>
      <DataType><Basic>Integer</Basic></DataType>
    </Response>
    <Response>
      <Identifier>Height</Identifier>
      <DisplayName>Height</DisplayName>
      <Description>Height in pixels.</Description>
      <DataType><Basic>Integer</Basic></DataType>
    </Response>
    <Response>
      <Identifier>Image</Identifier>
      <DisplayName>Image</DisplayName>
      <Description>Binary download identifier for the JPEG bytes.</Description>
      <DataType><Basic>Binary</Basic></DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>VideoSourceNotFound</Identifier>
      <Identifier>VideoFrameNotFound</Identifier>
      <Identifier>ProviderUnavailable</Identifier>
    </DefinedExecutionErrors>
  </Command>

  <Command>
    <Identifier>GetVideoTimeline</Identifier>
    <DisplayName>Get Video Timeline</DisplayName>
    <Description>Returns ordered half-open retained intervals, the newest retained timestamp when one exists, and provider live-availability metadata. The response does not open a stream and does not deliver frames added after the call.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Video source identifier.</Description>
      <DataType>
        <Constrained>
          <DataType><Basic>String</Basic></DataType>
          <Constraints>
            <MinimalLength>1</MinimalLength>
            <MaximalLength>128</MaximalLength>
            <Pattern>[A-Za-z0-9._:\-]+</Pattern>
          </Constraints>
        </Constrained>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Source whose retained coverage was requested.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>Intervals</Identifier>
      <DisplayName>Intervals</DisplayName>
      <Description>Ordered half-open retained intervals. A genuine temporal gap is a later interval. Recording files and storage partitions are not represented.</Description>
      <DataType><List><DataType><DataTypeIdentifier>TimeRange</DataTypeIdentifier></DataType></List></DataType>
    </Response>
    <Response>
      <Identifier>HasNewestAt</Identifier>
      <DisplayName>Has Newest At</DisplayName>
      <Description>True when NewestAt is set.</Description>
      <DataType><Basic>Boolean</Basic></DataType>
    </Response>
    <Response>
      <Identifier>NewestAt</Identifier>
      <DisplayName>Newest At</DisplayName>
      <Description>Newest retained timestamp. Ignored when HasNewestAt is false.</Description>
      <DataType><Basic>Timestamp</Basic></DataType>
    </Response>
    <Response>
      <Identifier>LiveAvailable</Identifier>
      <DisplayName>Live Available</DisplayName>
      <Description>Provider live-availability metadata. True when the provider reports live follow is currently available. This value does not open a stream.</Description>
      <DataType><Basic>Boolean</Basic></DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>VideoSourceNotFound</Identifier>
      <Identifier>LiveUnavailable</Identifier>
      <Identifier>ProviderUnavailable</Identifier>
    </DefinedExecutionErrors>
  </Command>

  <Command>
    <Identifier>GetVideoClip</Identifier>
    <DisplayName>Get Video Clip</DisplayName>
    <Description>Returns a bounded MJPEG clip handle and a binary download identifier for the finite multipart body. The body does not include frames added after the call.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Video source identifier.</Description>
      <DataType>
        <Constrained>
          <DataType><Basic>String</Basic></DataType>
          <Constraints>
            <MinimalLength>1</MinimalLength>
            <MaximalLength>128</MaximalLength>
            <Pattern>[A-Za-z0-9._:\-]+</Pattern>
          </Constraints>
        </Constrained>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Range</Identifier>
      <DisplayName>Range</DisplayName>
      <Description>Half-open UTC interval to clip.</Description>
      <DataType><DataTypeIdentifier>TimeRange</DataTypeIdentifier></DataType>
    </Parameter>
    <Response>
      <Identifier>ClipId</Identifier>
      <DisplayName>Clip Id</DisplayName>
      <Description>Clip identifier.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Source the clip was cut from.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>RequestedRange</Identifier>
      <DisplayName>Requested Range</DisplayName>
      <Description>Range the caller requested.</Description>
      <DataType><DataTypeIdentifier>TimeRange</DataTypeIdentifier></DataType>
    </Response>
    <Response>
      <Identifier>EffectiveRange</Identifier>
      <DisplayName>Effective Range</DisplayName>
      <Description>Range actually covered by retained frames.</Description>
      <DataType><DataTypeIdentifier>TimeRange</DataTypeIdentifier></DataType>
    </Response>
    <Response>
      <Identifier>MediaType</Identifier>
      <DisplayName>Media Type</DisplayName>
      <Description>MJPEG multipart media type.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>Path</Identifier>
      <DisplayName>Path</DisplayName>
      <Description>Relative download path. Never a URL and never bytes.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <Response>
      <Identifier>Clip</Identifier>
      <DisplayName>Clip</DisplayName>
      <Description>Binary download identifier for the finite MJPEG multipart body.</Description>
      <DataType><Basic>Binary</Basic></DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>VideoSourceNotFound</Identifier>
      <Identifier>VideoClipNotFound</Identifier>
      <Identifier>NoRecording</Identifier>
      <Identifier>RecordingGap</Identifier>
      <Identifier>ClipExpired</Identifier>
      <Identifier>ProviderUnavailable</Identifier>
    </DefinedExecutionErrors>
  </Command>

  <DataTypeDefinition>
    <Identifier>PageRequest</Identifier>
    <DisplayName>Page Request</DisplayName>
    <Description>Cursor and page size.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>HasCursor</Identifier>
          <DisplayName>Has Cursor</DisplayName>
          <Description>True when Cursor is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Cursor</Identifier>
          <DisplayName>Cursor</DisplayName>
          <Description>Opaque numeric cursor. Empty when HasCursor is false.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Limit</Identifier>
          <DisplayName>Limit</DisplayName>
          <Description>Page size from 1 to 1000.</Description>
          <DataType><Basic>Integer</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>TimeRange</Identifier>
    <DisplayName>Time Range</DisplayName>
    <Description>Half-open UTC interval.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Start</Identifier>
          <DisplayName>Start</DisplayName>
          <Description>Inclusive start.</Description>
          <DataType><Basic>Timestamp</Basic></DataType>
        </Element>
        <Element>
          <Identifier>End</Identifier>
          <DisplayName>End</DisplayName>
          <Description>Exclusive end.</Description>
          <DataType><Basic>Timestamp</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>VideoSource</Identifier>
    <DisplayName>Video Source</DisplayName>
    <Description>A named source that can supply timestamped MJPEG.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Id</Identifier>
          <DisplayName>Id</DisplayName>
          <Description>Source identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Name</Identifier>
          <DisplayName>Name</DisplayName>
          <Description>Human-readable name.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Description</Identifier>
          <DisplayName>Description</DisplayName>
          <Description>What the source records.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasAssetId</Identifier>
          <DisplayName>Has Asset Id</DisplayName>
          <Description>True when AssetId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>AssetId</Identifier>
          <DisplayName>Asset Id</DisplayName>
          <Description>Optional asset identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasSemanticId</Identifier>
          <DisplayName>Has Semantic Id</DisplayName>
          <Description>True when SemanticId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>SemanticId</Identifier>
          <DisplayName>Semantic Id</DisplayName>
          <Description>Optional semantic identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Width</Identifier>
          <DisplayName>Width</DisplayName>
          <Description>Frame width in pixels.</Description>
          <DataType><Basic>Integer</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Height</Identifier>
          <DisplayName>Height</DisplayName>
          <Description>Frame height in pixels.</Description>
          <DataType><Basic>Integer</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Fps</Identifier>
          <DisplayName>Fps</DisplayName>
          <Description>Nominal frames per second.</Description>
          <DataType><Basic>Integer</Basic></DataType>
        </Element>
        <Element>
          <Identifier>MediaType</Identifier>
          <DisplayName>Media Type</DisplayName>
          <Description>MJPEG multipart media type.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DefinedExecutionError>
    <Identifier>VideoSourceNotFound</Identifier>
    <DisplayName>Video Source Not Found</DisplayName>
    <Description>The video source does not exist.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>VideoFrameNotFound</Identifier>
    <DisplayName>Video Frame Not Found</DisplayName>
    <Description>No retained frame matches the requested instant.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>VideoClipNotFound</Identifier>
    <DisplayName>Video Clip Not Found</DisplayName>
    <Description>The clip handle does not exist.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>NoRecording</Identifier>
    <DisplayName>No Recording</DisplayName>
    <Description>The requested range contains no retained recording.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>RecordingGap</Identifier>
    <DisplayName>Recording Gap</DisplayName>
    <Description>The requested range crosses a gap between retained intervals.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>ClipExpired</Identifier>
    <DisplayName>Clip Expired</DisplayName>
    <Description>The prepared clip handle has expired.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>LiveUnavailable</Identifier>
    <DisplayName>Live Unavailable</DisplayName>
    <Description>The provider reports that live follow is not available. No LabVideos command delivers frames added after the call.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>ProviderUnavailable</Identifier>
    <DisplayName>Provider Unavailable</DisplayName>
    <Description>The equipment provider could not serve the request.</Description>
  </DefinedExecutionError>
</Feature>

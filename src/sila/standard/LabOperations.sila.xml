  <Command>
    <Identifier>GetTaskStatus</Identifier>
    <DisplayName>Get Task Status</DisplayName>
    <Description>Returns one task run.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>RunId</Identifier>
      <DisplayName>Run Id</DisplayName>
      <Description>Run identifier assigned at start.</Description>
      <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
    </Parameter>
    <Response>
      <Identifier>Run</Identifier>
      <DisplayName>Run</DisplayName>
      <Description>Current task run.</Description>
      <DataType><DataTypeIdentifier>TaskRun</DataTypeIdentifier></DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>RunNotFound</Identifier>
      <Identifier>ProviderUnavailable</Identifier>
    </DefinedExecutionErrors>
  </Command>

  <Command>
    <Identifier>StartTask</Identifier>
    <DisplayName>Start Task</DisplayName>
    <Description>Starts a task and reports execution status until it is terminal.</Description>
    <Observable>Yes</Observable>
    <Parameter>
      <Identifier>TaskId</Identifier>
      <DisplayName>Task Id</DisplayName>
      <Description>Task definition identifier.</Description>
      <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Input</Identifier>
      <DisplayName>Input</DisplayName>
      <Description>JSON object passed to the task.</Description>
      <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints><MaximalLength>262144</MaximalLength></Constraints>
          </Constrained>
        </DataType>
    </Parameter>
    <Response>
      <Identifier>Run</Identifier>
      <DisplayName>Run</DisplayName>
      <Description>Terminal task run.</Description>
      <DataType><DataTypeIdentifier>TaskRun</DataTypeIdentifier></DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>TaskNotFound</Identifier>
      <Identifier>ProviderUnavailable</Identifier>
    </DefinedExecutionErrors>
  </Command>

  <DataTypeDefinition>
    <Identifier>PageRequest</Identifier>
    <DisplayName>Page Request</DisplayName>
    <Description>Cursor and page size.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>HasCursor</Identifier>
          <DisplayName>Has Cursor</DisplayName>
          <Description>True when Cursor is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Cursor</Identifier>
          <DisplayName>Cursor</DisplayName>
          <Description>Opaque numeric cursor. Empty when HasCursor is false.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Limit</Identifier>
          <DisplayName>Limit</DisplayName>
          <Description>Page size from 1 to 1000.</Description>
          <DataType>
            <Constrained>
              <DataType><Basic>Integer</Basic></DataType>
              <Constraints>
                <MinimalInclusive>1</MinimalInclusive>
                <MaximalInclusive>1000</MaximalInclusive>
              </Constraints>
            </Constrained>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>TimeRange</Identifier>
    <DisplayName>Time Range</DisplayName>
    <Description>Half-open UTC interval.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Start</Identifier>
          <DisplayName>Start</DisplayName>
          <Description>Inclusive start.</Description>
          <DataType><Basic>Timestamp</Basic></DataType>
        </Element>
        <Element>
          <Identifier>End</Identifier>
          <DisplayName>End</DisplayName>
          <Description>Exclusive end.</Description>
          <DataType><Basic>Timestamp</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>LogSource</Identifier>
    <DisplayName>Log Source</DisplayName>
    <Description>A log source the equipment exposes.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Id</Identifier>
          <DisplayName>Id</DisplayName>
          <Description>Source identifier.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>Name</Identifier>
          <DisplayName>Name</DisplayName>
          <Description>Human-readable name.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Description</Identifier>
          <DisplayName>Description</DisplayName>
          <Description>What the source contains.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasAssetId</Identifier>
          <DisplayName>Has Asset Id</DisplayName>
          <Description>True when AssetId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>AssetId</Identifier>
          <DisplayName>Asset Id</DisplayName>
          <Description>Optional asset identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasSemanticId</Identifier>
          <DisplayName>Has Semantic Id</DisplayName>
          <Description>True when SemanticId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>SemanticId</Identifier>
          <DisplayName>Semantic Id</DisplayName>
          <Description>Optional semantic identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>LogRecord</Identifier>
    <DisplayName>Log Record</DisplayName>
    <Description>One structured log record.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>SourceId</Identifier>
          <DisplayName>Source Id</DisplayName>
          <Description>Source that emitted the record.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>Timestamp</Identifier>
          <DisplayName>Timestamp</DisplayName>
          <Description>When the record was emitted.</Description>
          <DataType><Basic>Timestamp</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Level</Identifier>
          <DisplayName>Level</DisplayName>
          <Description>Severity.</Description>
          <DataType>
            <Constrained>
              <DataType><Basic>String</Basic></DataType>
              <Constraints>
                <Set>
                  <Value>trace</Value>
                  <Value>debug</Value>
                  <Value>info</Value>
                  <Value>warn</Value>
                  <Value>error</Value>
                </Set>
              </Constraints>
            </Constrained>
          </DataType>
        </Element>
        <Element>
          <Identifier>Message</Identifier>
          <DisplayName>Message</DisplayName>
          <Description>Rendered message.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Attributes</Identifier>
          <DisplayName>Attributes</DisplayName>
          <Description>JSON object of structured attributes.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints><MaximalLength>262144</MaximalLength></Constraints>
          </Constrained>
        </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>MetricDescriptor</Identifier>
    <DisplayName>Metric Descriptor</DisplayName>
    <Description>A metric the equipment exposes.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Id</Identifier>
          <DisplayName>Id</DisplayName>
          <Description>Metric identifier.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>Name</Identifier>
          <DisplayName>Name</DisplayName>
          <Description>Human-readable name.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Description</Identifier>
          <DisplayName>Description</DisplayName>
          <Description>What the metric measures.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Unit</Identifier>
          <DisplayName>Unit</DisplayName>
          <Description>Unit of the sample value.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasAssetId</Identifier>
          <DisplayName>Has Asset Id</DisplayName>
          <Description>True when AssetId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>AssetId</Identifier>
          <DisplayName>Asset Id</DisplayName>
          <Description>Optional asset identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasSemanticId</Identifier>
          <DisplayName>Has Semantic Id</DisplayName>
          <Description>True when SemanticId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>SemanticId</Identifier>
          <DisplayName>Semantic Id</DisplayName>
          <Description>Optional semantic identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>MetricPoint</Identifier>
    <DisplayName>Metric Point</DisplayName>
    <Description>One finite sample.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Timestamp</Identifier>
          <DisplayName>Timestamp</DisplayName>
          <Description>When the sample was taken.</Description>
          <DataType><Basic>Timestamp</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Value</Identifier>
          <DisplayName>Value</DisplayName>
          <Description>Finite numeric value.</Description>
          <DataType><Basic>Real</Basic></DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>TaskDefinition</Identifier>
    <DisplayName>Task Definition</DisplayName>
    <Description>A task the equipment can start.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Id</Identifier>
          <DisplayName>Id</DisplayName>
          <Description>Task identifier.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>Name</Identifier>
          <DisplayName>Name</DisplayName>
          <Description>Human-readable name.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Description</Identifier>
          <DisplayName>Description</DisplayName>
          <Description>What the task does.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasAssetId</Identifier>
          <DisplayName>Has Asset Id</DisplayName>
          <Description>True when AssetId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>AssetId</Identifier>
          <DisplayName>Asset Id</DisplayName>
          <Description>Optional asset identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasSemanticId</Identifier>
          <DisplayName>Has Semantic Id</DisplayName>
          <Description>True when SemanticId is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>SemanticId</Identifier>
          <DisplayName>Semantic Id</DisplayName>
          <Description>Optional semantic identifier.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasInputSchema</Identifier>
          <DisplayName>Has Input Schema</DisplayName>
          <Description>True when InputSchema is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>InputSchema</Identifier>
          <DisplayName>Input Schema</DisplayName>
          <Description>JSON Schema for the task input.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints><MaximalLength>262144</MaximalLength></Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>HasOutputSchema</Identifier>
          <DisplayName>Has Output Schema</DisplayName>
          <Description>True when OutputSchema is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>OutputSchema</Identifier>
          <DisplayName>Output Schema</DisplayName>
          <Description>JSON Schema for the task result.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints><MaximalLength>262144</MaximalLength></Constraints>
          </Constrained>
        </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>

  <DataTypeDefinition>
    <Identifier>TaskRun</Identifier>
    <DisplayName>Task Run</DisplayName>
    <Description>A started task.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Id</Identifier>
          <DisplayName>Id</DisplayName>
          <Description>Run identifier.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>TaskId</Identifier>
          <DisplayName>Task Id</DisplayName>
          <Description>Definition that was started.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>State</Identifier>
          <DisplayName>State</DisplayName>
          <Description>Run state.</Description>
          <DataType>
            <Constrained>
              <DataType><Basic>String</Basic></DataType>
              <Constraints>
                <Set>
                  <Value>submitted</Value>
                  <Value>working</Value>
                  <Value>completed</Value>
                  <Value>failed</Value>
                  <Value>canceled</Value>
                </Set>
              </Constraints>
            </Constrained>
          </DataType>
        </Element>
        <Element>
          <Identifier>Input</Identifier>
          <DisplayName>Input</DisplayName>
          <Description>JSON object supplied at start.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints><MaximalLength>262144</MaximalLength></Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>HasMessage</Identifier>
          <DisplayName>Has Message</DisplayName>
          <Description>True when Message is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Message</Identifier>
          <DisplayName>Message</DisplayName>
          <Description>Optional status detail.</Description>
          <DataType><Basic>String</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasResult</Identifier>
          <DisplayName>Has Result</DisplayName>
          <Description>True when Result is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Result</Identifier>
          <DisplayName>Result</DisplayName>
          <Description>JSON object returned by the task.</Description>
          <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints><MaximalLength>262144</MaximalLength></Constraints>
          </Constrained>
        </DataType>
        </Element>
        <Element>
          <Identifier>HasProgress</Identifier>
          <DisplayName>Has Progress</DisplayName>
          <Description>True when Progress is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>
        </Element>
        <Element>
          <Identifier>Progress</Identifier>
          <DisplayName>Progress</DisplayName>
          <Description>Observable progress from 0 through 1.</Description>
          <DataType><Basic>Real</Basic></DataType>
        </Element>
        <Element>
          <Identifier>HasErrorKind</Identifier>
          <DisplayName>Has Error Kind</DisplayName>
          <Description>True when ErrorKind is set.</Description>
          <DataType><Basic>Boolean</Basic></DataType>

<?xml version="1.0" encoding="utf-8" ?>
<Feature SiLA2Version="1.1" FeatureVersion="1.0" MaturityLevel="Draft" Originator="com.a3analytics" Category="lab"
         xmlns="http://www.sila-standard.org"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>LabOperations</Identifier>
  <DisplayName>Lab Operations</DisplayName>
  <Description>Exposes the seven lab operations of the devkit that represents the equipment.</Description>

  <Command>
    <Identifier>ListLogSources</Identifier>
    <DisplayName>List Log Sources</DisplayName>
    <Description>Returns one page of log sources.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Page</Identifier>
      <DisplayName>Page</DisplayName>
      <Description>Page bounds.</Description>
      <DataType><DataTypeIdentifier>PageRequest</DataTypeIdentifier></DataType>
    </Parameter>
    <Response>
      <Identifier>Sources</Identifier>
      <DisplayName>Sources</DisplayName>
      <Description>Log sources on this page.</Description>
      <DataType><List><DataType><DataTypeIdentifier>LogSource</DataTypeIdentifier></DataType></List></DataType>
    </Response>
    <Response>
      <Identifier>HasNextCursor</Identifier>
      <DisplayName>Has Next Cursor</DisplayName>
      <Description>True when another page exists.</Description>
      <DataType><Basic>Boolean</Basic></DataType>
    </Response>
    <Response>
      <Identifier>NextCursor</Identifier>
      <DisplayName>Next Cursor</DisplayName>
      <Description>Cursor for the next page. Empty when HasNextCursor is false.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <DefinedExecutionErrors><Identifier>ProviderUnavailable</Identifier></DefinedExecutionErrors>
  </Command>

  <Command>
    <Identifier>QueryLogs</Identifier>
    <DisplayName>Query Logs</DisplayName>
    <Description>Returns log records in a half-open UTC range.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>SourceId</Identifier>
      <DisplayName>Source Id</DisplayName>
      <Description>Log source identifier.</Description>
      <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Range</Identifier>
      <DisplayName>Range</DisplayName>
      <Description>Half-open UTC interval.</Description>
      <DataType><DataTypeIdentifier>TimeRange</DataTypeIdentifier></DataType>
    </Parameter>
    <Parameter>
      <Identifier>Page</Identifier>
      <DisplayName>Page</DisplayName>
      <Description>Page bounds.</Description>
      <DataType><DataTypeIdentifier>PageRequest</DataTypeIdentifier></DataType>
    </Parameter>
    <Response>
      <Identifier>Records</Identifier>
      <DisplayName>Records</DisplayName>
      <Description>Log records on this page.</Description>
      <DataType><List><DataType><DataTypeIdentifier>LogRecord</DataTypeIdentifier></DataType></List></DataType>
    </Response>
    <Response>
      <Identifier>HasNextCursor</Identifier>
      <DisplayName>Has Next Cursor</DisplayName>
      <Description>True when another page exists.</Description>
      <DataType><Basic>Boolean</Basic></DataType>
    </Response>
    <Response>
      <Identifier>NextCursor</Identifier>
      <DisplayName>Next Cursor</DisplayName>
      <Description>Cursor for the next page.</Description>
      <DataType><Basic>String</Basic></DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>SourceNotFound</Identifier>
      <Identifier>ProviderUnavailable</Identifier>
    </DefinedExecutionErrors>
  </Command>


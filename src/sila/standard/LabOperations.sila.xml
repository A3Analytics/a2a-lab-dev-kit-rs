    <Response>
      <Identifier>Metrics</Identifier>
      <DisplayName>Metrics</DisplayName>
      <Description>Metric descriptors on this page.</Description>
      <DataType><List><DataType><DataTypeIdentifier>MetricDescriptor</DataTypeIdentifier></DataType></List></DataType>
    </Response>
    <Response>
      <Identifier>HasNextCursor</Identifier>
      <DisplayName>Has Next Cursor</DisplayName>
      <Description>True when another page exists.</Description>

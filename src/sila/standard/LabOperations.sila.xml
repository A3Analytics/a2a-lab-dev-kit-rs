  <Command>
    <Identifier>QueryMetric</Identifier>
    <DisplayName>Query Metric</DisplayName>
    <Description>Returns metric samples in a half-open UTC range.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>MetricId</Identifier>
      <DisplayName>Metric Id</DisplayName>
      <Description>Metric identifier.</Description>
      <DataType>
          <Constrained>
            <DataType><Basic>String</Basic></DataType>
            <Constraints>
              <MinimalLength>1</MinimalLength>
              <MaximalLength>128</MaximalLength>
              <Pattern>[A-Za-z0-9._:\-]+</Pattern>
            </Constraints>
          </Constrained>
        </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Range</Identifier>
      <DisplayName>Range</DisplayName>
      <Description>Half-open UTC interval.</Description>
      <DataType><DataTypeIdentifier>TimeRange</DataTypeIdentifier></DataType>
    </Parameter>
    <Parameter>
      <Identifier>Page</Identifier>
      <DisplayName>Page</DisplayName>
      <Description>Page bounds.</Description>
      <DataType><DataTypeIdentifier>PageRequest</DataTypeIdentifier></DataType>
    </Parameter>
    <Response>
      <Identifier>Points</Identifier>
      <DisplayName>Points</DisplayName>
      <Description>Samples on this page.</Description>
